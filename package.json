{
  "name": "react-native-picker-select",
  "version": "9.3.1",
  "description": "A Picker component for React Native which emulates the native <select> interfaces for each platform",
  "license": "MIT",
  "author": "Michael Lefkowitz <lefkowitz.michael@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lawnstarter/react-native-picker-select.git"
  },
  "main": "src/index.js",
  "keywords": [
    "dropdown",
    "picker",
    "select",
    "react",
    "react-native",
    "react native",
    "expo",
    "items"
  ],
  "files": [
    "index.d.ts",
    "/src"
  ],
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-flow": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@commitlint/cli": "^20.1.0",
    "@react-native-picker/picker": "^2.11.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.0.0",
    "@types/react-native": "^0.73.0",
    "cz-ls-commits": "^3.0.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.0.11",
    "jest": "^29.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.2.5",
    "prop-types": "^15.7.2",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.0",
    "react-test-renderer": "^18.2.0"
  },
  "peerDependencies": {
    "@react-native-picker/picker": "^2.11.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "open:coverage": "open ./coverage/lcov-report/index.html",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "yarn lint --fix",
    "prepare": "husky"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "./test/setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-native-picker/picker)/)"
    ]
  }
}
